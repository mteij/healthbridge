# Healthbridge configuration. Copy to `.env` next to docker-compose.yml:
#
#   cp .env.example .env && docker compose up -d
#
# Every line is optional; the values shown are the defaults.

# --- Security ----------------------------------------------------------------

# Secret that encrypts stored records. Set it BEFORE the first sync.
# Generate one with: openssl rand -base64 48
# Leave empty to use the weak legacy key (all users share one key).
HB_DATA_KEY=

# The first account to sign in becomes the owner and registration then closes.
# Set to "true" to let more people create accounts.
HB_ALLOW_REGISTRATION=false

# Maximum number of accounts while registration is open. Empty = unlimited.
HB_MAX_USERS=

# --- Retention ---------------------------------------------------------------

# Delete accounts, and all their data, that have been inactive for this many days.
# Any sync, login or API key use counts as activity. Empty or 0 = never delete.
HB_STALE_DAYS=

# Usernames that are never deleted (comma separated), e.g. the owner.
HB_STALE_EXEMPT=

# "true" = only log which accounts would be deleted.
HB_STALE_DRY_RUN=false

# --- General -----------------------------------------------------------------

# Timezone used for daily totals and sleep dates in the MCP tools.
HB_TIMEZONE=Europe/Amsterdam

# DEBUG, INFO, WARNING or ERROR.
HB_LOG_LEVEL=INFO

# --- Optional: push/delete to the phone via Firebase Cloud Messaging ----------
# Needs a Firebase service-account.json mounted at /app/service-account.json.
FCM_PROJECT_ID=

# --- Not needed with the bundled docker-compose.yml ---------------------------
# MONGO_URI=mongodb://db:27017/hcgateway
